                      "type": "task",
                      "name": "Neue_Karte_Bereit"
                    }
                  ],
                  "elseBody": [
                    {
                      "type": "task",
                      "name": "Karte_Laden"
                    }
                  ]
                }
              ],
              "elseBody": [
                {
                  "type": "action",
                  "name": "Act_Keine_Rechte"
                }
              ]
            }
          ],
          "elseBody": [
            {
              "type": "action",
              "name": "Act_Ladefehler"
            }
          ]
        }
      ],
      "triggerMode": "local-sync",
      "params": []
    },
