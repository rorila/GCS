  "actions": [
    {
      "id": "deck_card_action_Act_Zurueck",
      "name": "Act_Zurueck",
      "scope": "stage",
      "type": "navigate_stage",
      "stageId": "stage_decks_edit",
      "reset": true
    },
    {
      "id": "deck_card_action_Act_Laden",
      "name": "Act_Laden",
      "scope": "stage",
      "type": "property",
      "changes": {
        "KartenEditorBusy": 1,
        "Zurueck.enabled": false,
        "Speichern.enabled": false,
        "SpeichernWeiter.enabled": false,
        "FormatText.enabled": false,
        "FormatSelf.enabled": false,
        "KarteLoeschen.enabled": false,
        "Status.text": "Stapel wird geladen …"
      }
    },
    {
      "id": "deck_card_action_Act_Info_Server",
      "name": "Act_Info_Server",
      "scope": "stage",
      "type": "http",
      "url": "/api/cms/decks/info",
      "method": "POST",
      "body": {
        "token": "${Token}",
        "deckId": "${DeckKontextId}"
      },
      "resultVariable": "InfoAntwort",
      "queryOperator": "==",
      "resultVariable_ref": "deck_card_var_InfoAntwort"
    },
    {
      "id": "deck_card_action_Act_Stapel_Uebernehmen",
      "name": "Act_Stapel_Uebernehmen",
      "scope": "stage",
      "type": "property",
      "changes": {
        "Manageable": true,
        "StapelInfo.text": "Stapel: ${InfoAntwort.deck.name}",
        "FachKarte.text": "${InfoAntwort.deck.subject}",
        "ThemaKarte.text": "${InfoAntwort.deck.name}",
        "ErstellerInfo.text": "Erstellt von: ${InfoAntwort.currentUserName}"
      }
    },
    {
      "id": "deck_card_action_Act_Keine_Rechte",
      "name": "Act_Keine_Rechte",
      "scope": "stage",
      "type": "property",
      "changes": {
        "KartenEditorBusy": 0,
        "Manageable": false,
        "Zurueck.enabled": true,
        "Status.text": "Dieser Stapel kann nicht bearbeitet werden."
      }
    },
    {
      "id": "deck_card_action_Act_Ladefehler",
      "name": "Act_Ladefehler",
      "scope": "stage",
      "type": "property",
      "changes": {
        "KartenEditorBusy": 0,
        "Zurueck.enabled": true,
        "Status.text": "${InfoAntwort.message}"
      }
    },
    {
      "id": "deck_card_action_Act_Neu",
      "name": "Act_Neu",
      "scope": "stage",
      "type": "property",
      "changes": {
        "KartenEditorBusy": 0,
        "DeckKarteKontextId": "",
        "Format": "text",
        "Zurueck.enabled": true,
        "Speichern.enabled": true,
        "SpeichernWeiter.enabled": true,
        "FormatText.enabled": true,
        "FormatSelf.enabled": true,
        "KarteLoeschen.enabled": true,
        "Titel.text": "NEUE KARTE",
        "FrageNeu.text": "",
        "AntwortenNeu.text": "",
        "FalscheAntwortenNeu.text": "",
        "KarteLoeschen.visible": false,
        "ErstellerInfo.text": "Erstellt von: ${InfoAntwort.currentUserName}",
        "FormatText.text": "⌨ Eingabe ✓",
        "FormatSelf.text": "🙋 Selbst",
        "Status.text": "Frage und Antwort eingeben."
      }
    },
    {
      "id": "deck_card_action_Act_Karten_Server",
      "name": "Act_Karten_Server",
      "scope": "stage",
      "type": "http",
      "url": "/api/cms/decks/cards",
      "method": "POST",
      "body": {
        "token": "${Token}",
        "deckId": "${DeckKontextId}",
        "cardId": "${DeckKarteKontextId}"
      },
      "resultVariable": "KartenAntwort",
      "queryOperator": "==",
      "resultVariable_ref": "deck_card_var_KartenAntwort"
    },
    {
      "id": "deck_card_action_Act_Karte_Uebernehmen",
      "name": "Act_Karte_Uebernehmen",
      "scope": "stage",
      "type": "property",
      "changes": {
        "KartenEditorBusy": 0,
        "Zurueck.enabled": true,
        "Speichern.enabled": true,
        "SpeichernWeiter.enabled": true,
        "FormatText.enabled": true,
        "FormatSelf.enabled": true,
        "KarteLoeschen.enabled": true,
        "Titel.text": "KARTE BEARBEITEN",
        "FrageNeu.text": "${KartenAntwort.card.question}",
        "AntwortenNeu.text": "${KartenAntwort.card.answersText}",
        "FalscheAntwortenNeu.text": "${KartenAntwort.card.wrongAnswersText}",
        "FachKarte.text": "${KartenAntwort.card.subject}",
        "ThemaKarte.text": "${KartenAntwort.card.topic}",
        "Format": "${KartenAntwort.card.answerFormat}",
        "ErstellerInfo.text": "Erstellt von: ${KartenAntwort.card.createdByName}",
        "KarteLoeschen.visible": true,
        "Status.text": "Frage oder Antwort ändern und speichern."
      }
    },
    {
      "id": "deck_card_action_Act_Karte_Fehlt",
      "name": "Act_Karte_Fehlt",
      "scope": "stage",
      "type": "property",
      "changes": {
        "KartenEditorBusy": 0,
        "Zurueck.enabled": true,
        "Status.text": "Die Karte wurde nicht gefunden."
      }
    },
    {
      "id": "deck_card_action_Act_Kartenfehler",
      "name": "Act_Kartenfehler",
      "scope": "stage",
      "type": "property",
      "changes": {
        "KartenEditorBusy": 0,
        "Zurueck.enabled": true,
        "Status.text": "${KartenAntwort.message}"
      }
    },
    {
      "id": "deck_card_action_Act_Modus_Speichern",
      "name": "Act_Modus_Speichern",
      "scope": "stage",
      "type": "property",
      "changes": {
        "Weiter": false,
        "KartenEditorBusy": 1
      }
    },
    {
      "id": "deck_card_action_Act_Modus_Speichern_Weiter",
      "name": "Act_Modus_Speichern_Weiter",
      "scope": "stage",
      "type": "property",
      "changes": {
        "Weiter": true,
        "KartenEditorBusy": 1
      }
    },
    {
      "id": "deck_card_action_Act_Speichern_Start",
      "name": "Act_Speichern_Start",
      "scope": "stage",
      "type": "property",
      "changes": {
        "KartenEditorBusy": 1,
        "Zurueck.enabled": false,
        "Speichern.enabled": false,
        "SpeichernWeiter.enabled": false,
        "FormatText.enabled": false,
        "FormatSelf.enabled": false,
        "KarteLoeschen.enabled": false,
        "Status.text": "Karte wird gespeichert …"
      }
    },
    {
      "id": "deck_card_action_Act_Speichern_Server",
      "name": "Act_Speichern_Server",
      "scope": "stage",
      "type": "http",
      "url": "/api/cms/decks/card-save",
      "method": "POST",
      "body": {
        "token": "${Token}",
        "deckId": "${DeckKontextId}",
        "cardId": "${DeckKarteKontextId}",
        "question": "${FrageNeu.text}",
        "answers": "${AntwortenNeu.text}",
        "wrongAnswers": "${FalscheAntwortenNeu.text}",
        "subject": "${FachKarte.text}",
        "topic": "${ThemaKarte.text}",
        "answerFormat": "${Format}"
      },
      "resultVariable": "SpeicherAntwort",
      "queryOperator": "==",
      "resultVariable_ref": "deck_card_var_SpeicherAntwort"
    },
    {
      "id": "deck_card_action_Act_Weitere_Karte",
      "name": "Act_Weitere_Karte",
      "scope": "stage",
      "type": "property",
      "changes": {
        "Status.text": "Karte gespeichert. Die nächste Karte kann eingegeben werden."
      }
    },
    {
      "id": "deck_card_action_Act_Speicherfehler",
      "name": "Act_Speicherfehler",
      "scope": "stage",
      "type": "property",
      "changes": {
        "KartenEditorBusy": 0,
        "Zurueck.enabled": true,
        "Speichern.enabled": true,
        "SpeichernWeiter.enabled": true,
        "FormatText.enabled": true,
        "FormatSelf.enabled": true,
        "KarteLoeschen.enabled": true,
        "Status.text": "${SpeicherAntwort.message}"
      }
    },
    {
      "id": "deck_card_action_Act_Loeschen_Start",
      "name": "Act_Loeschen_Start",
      "scope": "stage",
      "type": "property",
      "changes": {
        "KartenEditorBusy": 1,
