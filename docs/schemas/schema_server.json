{
  "$module": "server",
  "description": "Server-Workflow-Pilot: Anmeldung und nachvollziehbare Request-/Response-Diagnose",
  "components": {
    "TServerEndpoint": {
      "description": "Empfängt die serverseitige Emoji-Anmeldung. Ausführung im CMS-Server.",
      "stage": "blueprint",
      "category": "server",
      "isService": true,
      "isHiddenInRun": true,
      "properties": {
        "endpointPath": {
          "type": "string",
          "default": "/api/cms/login",
          "description": "Anfragepfad, im Pilot fest"
        },
        "httpMethod": {
          "type": "string",
          "default": "POST",
          "description": "Methode, im Pilot fest"
        },
        "traceEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Erfassung für explizite Debug-Anfragen"
        }
      },
      "methods": [],
      "events": [
        "onRequest"
      ],
      "example": {
        "className": "TServerEndpoint",
        "name": "ServerEndpoint",
        "executionSide": "server",
        "isService": true,
        "isHiddenInRun": true,
        "endpointPath": "/api/cms/login",
        "httpMethod": "POST",
        "traceEnabled": true
      }
    },
    "TServerValidate": {
      "description": "Prüft Haus-ID und vier Emoji-Schlüssel; Zugangscode bleibt im Log maskiert.",
      "stage": "blueprint",
      "category": "server",
      "isService": true,
      "isHiddenInRun": true,
      "properties": {
        "validationRule": {
          "type": "string",
          "default": "Haus-ID und genau vier Emoji-Schlüssel",
          "description": "Verbindliche Regel"
        },
        "failureMessage": {
          "type": "string",
          "default": "Bitte Haus und vier Bilder angeben.",
          "description": "Rückmeldung bei ungültiger Eingabe"
        }
      },
      "methods": [
        {
          "name": "execute",
          "description": "Nur der CMS-Server führt diesen Schritt aus."
        }
      ],
      "events": [],
      "example": {
        "className": "TServerValidate",
        "name": "ServerValidate",
        "executionSide": "server",
        "isService": true,
        "isHiddenInRun": true,
        "validationRule": "Haus-ID und genau vier Emoji-Schlüssel",
        "failureMessage": "Bitte Haus und vier Bilder angeben."
      }
    },
    "TServerAuthenticate": {
      "description": "Prüft den Zugang des konfigurierten Anmeldeprojekts: Emoji-Spielerprofil oder Verwaltungspasswort. Der Server erzwingt das Verfahren pro Endpunkt.",
      "stage": "blueprint",
      "category": "server",
      "isService": true,
      "isHiddenInRun": true,
      "properties": {
        "authenticationMode": {
          "type": "string",
          "default": "Emoji-Spielerprofil",
          "description": "Anmeldeverfahren"
        },
        "permissionBoundary": {
          "type": "string",
          "default": "Keine Verwaltungsrechte durch Emoji-Anmeldung",
          "description": "Verbindliche Grenze"
        },
        "failureMessage": {
          "type": "string",
          "default": "🤔 Noch einmal versuchen",
          "description": "Rückmeldung bei abgelehnter Anmeldung"
        }
      },
      "methods": [
        {
          "name": "execute",
          "description": "Nur der CMS-Server führt diesen Schritt aus."
        }
      ],
      "events": [],
      "example": {
        "className": "TServerAuthenticate",
        "name": "ServerAuthenticate",
        "executionSide": "server",
        "isService": true,
        "isHiddenInRun": true,
        "authenticationMode": "Emoji-Spielerprofil",
        "permissionBoundary": "Keine Verwaltungsrechte durch Emoji-Anmeldung",
        "failureMessage": "🤔 Noch einmal versuchen"
      }
    },
    "TServerResponse": {
      "description": "Erstellt die JSON-Anmeldeantwort; sensible Daten sind nur in der tatsächlichen Antwort, niemals im Debug-Protokoll.",
      "stage": "blueprint",
      "category": "server",
      "isService": true,
      "isHiddenInRun": true,
      "properties": {
        "successMessage": {
          "type": "string",
          "default": "✓",
          "description": "Erfolgsmeldung"
        },
        "responseFormat": {
          "type": "string",
          "default": "JSON",
          "description": "Antwortformat"
        },
        "secretPolicy": {
          "type": "string",
          "default": "Passwörter, Emoji-Code, Cookies und Tokens maskieren",
          "description": "Nicht abschaltbare Maskierung"
        }
      },
      "methods": [
        {
          "name": "execute",
          "description": "Nur der CMS-Server führt diesen Schritt aus."
        }
      ],
      "events": [],
      "example": {
        "className": "TServerResponse",
        "name": "ServerResponse",
        "executionSide": "server",
        "isService": true,
        "isHiddenInRun": true,
        "successMessage": "✓",
        "responseFormat": "JSON",
        "secretPolicy": "Passwörter, Emoji-Code, Cookies und Tokens maskieren"
      }
    },
    "TServerSession": {
      "description": "Erstellt eine Verwaltungssitzung ausschließlich nach erfolgreicher Zugangsprüfung.",
      "stage": "blueprint",
      "category": "server",
      "isService": true,
      "isHiddenInRun": true,
      "properties": {
        "sessionPolicy": {
          "type": "string",
          "default": "HttpOnly; SameSite=Strict; 30 Minuten",
          "description": "Verbindlicher serverseitiger Sitzungsschutz"
        }
      },
      "methods": [
        {
          "name": "execute",
          "description": "Nur im CMS-Server nach geprüfter Authentifizierung ausführen"
        }
      ],
      "events": [],
      "example": {
        "className": "TServerSession",
        "name": "VerwaltungssitzungErstellen"
      }
    },
    "TServerProfile": {
      "description": "Eigene Profilangaben lesen und speichern; Zugangshilfe anfordern. Identität aus Sitzung.",
      "category": "server",
      "stage": "blueprint",
      "properties": {
        "readMessage": {
          "type": "string",
          "description": "Profilhinweis"
        },
        "savedMessage": {
          "type": "string",
          "description": "Speicherbestätigung"
        },
        "helpMessage": {
          "type": "string",
          "description": "Hilfebestätigung"
        },
        "failureMessage": {
          "type": "string",
          "description": "Eingabefehler"
        }
      },
      "methods": [
        {
          "name": "read",
          "description": "Serverseitiger Profilschritt"
        },
        {
          "name": "save",
          "description": "Serverseitiger Profilschritt"
        },
        {
          "name": "help",
          "description": "Serverseitiger Profilschritt"
        }
      ],
      "events": [
        "onRead",
        "onSave",
        "onHelp"
      ],
      "example": {
        "className": "TServerProfile",
        "name": "EigenesProfil"
      }
    },
    "TFilePicker": {
      "description": "Wiederverwendbarer Upload-Baustein: TFilePicker",
      "stage": "blueprint",
      "properties": {
        "accept": {
          "type": "string",
          "default": ".json",
          "description": "accept"
        },
        "maxBytes": {
          "type": "number",
          "default": 10485760,
          "description": "maxBytes"
        }
      },
      "methods": [
        {
          "name": "choose"
        }
      ],
      "events": [
        "onSelected",
        "onCancel",
        "onError"
      ],
      "example": {
        "className": "TFilePicker",
        "name": "FilePicker"
      }
    },
    "TFileUpload": {
      "description": "Wiederverwendbarer Upload-Baustein: TFileUpload",
      "stage": "blueprint",
      "properties": {
        "picker": {
          "type": "string",
          "default": "Dateiauswahl",
          "description": "picker"
        },
        "endpoint": {
          "type": "string",
          "default": "/api/cms/upload/game",
          "description": "endpoint"
        }
      },
      "methods": [
        {
          "name": "start",
          "parameters": [
            {
              "name": "title",
              "type": "string"
            },
            {
              "name": "description",
              "type": "string"
            },
            {
              "name": "token",
              "type": "string",
              "description": "Spieler-Token nur für Avatarupload; nicht in der Projektdatei speichern."
            }
          ]
        },
        {
          "name": "cancel"
        }
      ],
      "events": [
        "onStarted",
        "onProgress",
        "onSuccess",
        "onError",
        "onCancel"
      ],
      "example": {
        "className": "TFileUpload",
        "name": "FileUpload"
      }
    },
    "TServerUpload": {
      "description": "Wiederverwendbarer Upload-Baustein: TServerUpload",
      "stage": "blueprint",
      "properties": {
        "kind": {
          "type": "string",
          "default": "game",
          "description": "kind"
        },
        "maxBytes": {
          "type": "number",
          "default": 10485760,
          "description": "maxBytes"
        },
        "successMessage": {
          "type": "string",
          "default": "Upload gespeichert",
          "description": "successMessage"
        },
        "failureMessage": {
          "type": "string",
          "default": "Dateiformat ungültig",
          "description": "failureMessage"
        }
      },
      "methods": [
        {
          "name": "execute"
        }
      ],
      "events": [
        "onRequest"
      ],
      "example": {
        "className": "TServerUpload",
        "name": "ServerUpload"
      }
    }
  }
}