{
  "$module": "dialogs",
  "description": "Dialog-Container (Modal, Side-Panel)",
  "components": {
    "TDialogRoot": {
      "description": "Container für Dialoge. Modal/Non-Modal, Slide-In Animation, Show/Hide/Toggle per Action.",
      "stage": "main",
      "category": "ui",
      "isContainer": true,
      "properties": {
        "title": {
          "type": "string",
          "default": "Dialog",
          "description": "Titel im Dialog-Header"
        },
        "modal": {
          "type": "boolean",
          "default": true,
          "description": "Hintergrund blockieren (Overlay)"
        },
        "closable": {
          "type": "boolean",
          "default": true,
          "description": "Schließen-Button anzeigen"
        },
        "draggableAtRuntime": {
          "type": "boolean",
          "default": true,
          "description": "Im Run-Modus verschiebbar"
        },
        "centerOnShow": {
          "type": "boolean",
          "default": true,
          "description": "Beim Öffnen zentrieren"
        },
        "slideDirection": {
          "type": "select",
          "default": "right",
          "options": [
            "left",
            "right"
          ],
          "description": "Slide-Richtung der Animation"
        }
      },
      "methods": [
        {
          "name": "show",
          "description": "Dialog einblenden (via call_method Action)"
        },
        {
          "name": "hide",
          "description": "Dialog ausblenden"
        },
        {
          "name": "close",
          "description": "Dialog schließen (feuert onClose Event)"
        },
        {
          "name": "cancel",
          "description": "Dialog abbrechen (feuert onCancel Event)"
        },
        {
          "name": "toggle",
          "description": "Sichtbarkeit umschalten"
        }
      ],
      "events": [
        "onShow",
        "onClose",
        "onCancel"
      ],
      "example": {
        "className": "TDialogRoot",
        "name": "SettingsDialog",
        "x": 10,
        "y": 5,
        "width": 20,
        "height": 15,
        "visible": false,
        "modal": true,
        "closable": true,
        "title": "Einstellungen",
        "style": {
          "backgroundColor": "rgba(26, 26, 46, 0.98)",
          "borderColor": "#4fc3f7",
          "borderWidth": 2
        },
        "children": []
      },
      "warnings": [
        "⚠️ visible=false ist der Default! Dialog muss per toggle_dialog oder call_method 'show' geöffnet werden.",
        "⚠️ Im Editor ist der Dialog sichtbar zum Editieren, im Run-Modus initial verborgen.",
        "⚠️ Children haben relative Koordinaten zum Dialog, nicht zur Stage!"
      ]
    },
    "TSidePanel": {
      "description": "Side-Panel, das von links oder rechts einschiebt. Erbt von TDialogRoot. Volle Bühnenhöhe, optional resizable.",
      "stage": "main",
      "category": "ui",
      "isContainer": true,
      "properties": {
        "title": {
          "type": "string",
          "default": "",
          "description": "Titel im Panel-Header"
        },
        "side": {
          "type": "select",
          "default": "right",
          "options": [
            "left",
            "right"
          ],
          "description": "Andock-Seite"
        },
        "resizable": {
          "type": "boolean",
          "default": true,
          "description": "Resize-Handle im Run-Modus"
        },
        "overlayDimming": {
          "type": "boolean",
          "default": false,
          "description": "Hintergrund dimmen (unabhängig von modal)"
        },
        "modal": {
          "type": "boolean",
          "default": false,
          "description": "Hintergrund blockieren"
        },
        "closable": {
          "type": "boolean",
          "default": true,
          "description": "Schließen-Button anzeigen"
        }
      },
      "methods": [
        {
          "name": "show",
          "description": "Panel einblenden"
        },
        {
          "name": "hide",
          "description": "Panel ausblenden"
        },
        {
          "name": "close",
          "description": "Panel schließen (feuert onClose)"
        },
        {
          "name": "toggle",
          "description": "Sichtbarkeit umschalten"
        }
      ],
      "events": [
        "onShow",
        "onClose",
        "onCancel"
      ],
      "example": {
        "className": "TSidePanel",
        "name": "DebugPanel",
        "x": 0,
        "y": 0,
        "width": 15,
        "height": 40,
        "visible": false,
        "side": "right",
        "resizable": true,
        "closable": true,
        "style": {
          "backgroundColor": "rgba(20, 20, 35, 0.97)",
          "borderColor": "#4fc3f7",
          "borderWidth": 1
        },
        "children": []
      },
      "warnings": [
        "⚠️ modal ist bei TSidePanel default false (anders als bei TDialogRoot!)",
        "⚠️ centerOnShow und draggableAtRuntime sind automatisch deaktiviert."
      ]
    },
    "TOverlay": {
      "description": "Modale Overlay-Karte, die ein ANDERES Projekt in einem iframe hostet (eigene Runtime). Position und Groesse der Komponente bestimmen die Karte; die Stage wird abgedunkelt und optional pausiert.",
      "stage": "main",
      "category": "ui",
      "properties": {
        "overlayProject": {
          "type": "string",
          "default": "",
          "description": "Projektname ohne .json, z.B. \"Kopfrechnen\". Wird ueber player.html?game= geladen."
        },
        "params": {
          "type": "json",
          "default": "",
          "description": "Uebergabedaten an das Overlay, z.B. {\"aufgaben\": 10}. Stehen dort als ${…}-Variablen bereit."
        },
        "pauseGame": {
          "type": "boolean",
          "default": true,
          "description": "GameLoop des Hauptspiels einfrieren, solange das Overlay offen ist"
        },
        "dimOpacity": {
          "type": "number",
          "default": 0.5,
          "description": "Abdunkelung hinter der Karte (0-1)"
        },
        "closable": {
          "type": "boolean",
          "default": true,
          "description": "X-Button oben rechts auf der Karte. false = Kind kann das Overlay nicht selbst schliessen."
        },
        "closeOnEscape": {
          "type": "boolean",
          "default": true,
          "description": "Escape-Taste schliesst das Overlay (ohne Ergebnis)"
        },
        "isOpen": {
          "type": "boolean",
          "default": false,
          "description": "Laufzeit-Status (readonly)"
        }
      },
      "methods": [
        {
          "name": "show",
          "description": "Overlay oeffnen (via call_method). Optionaler Parameter: JSON-Objekt mit zusaetzlichen Uebergabedaten.",
          "params": [
            "params?"
          ]
        },
        {
          "name": "close",
          "description": "Overlay schliessen, optional mit Ergebnis-Objekt. Feuert onOverlayResult + onOverlayClosed.",
          "params": [
            "result?"
          ]
        }
      ],
      "events": [
        "onOverlayResult",
        "onOverlayClosed"
      ],
      "example": {
        "className": "TOverlay",
        "name": "MatheOverlay",
        "x": 12,
        "y": 6,
        "width": 24,
        "height": 20,
        "visible": false,
        "overlayProject": "Kopfrechnen",
        "params": "{\"aufgaben\": 10}",
        "pauseGame": true,
        "dimOpacity": 0.5,
        "events": {
          "onOverlayResult": "MatheFertig"
        }
      },
      "warnings": [
        "⚠️ visible=false ist der Default! Die Karte erscheint erst per call_method 'show' und verschwindet bei close wieder.",
        "⚠️ Das Overlay-Projekt sieht KEINE Objekte des Hauptspiels — nur params rein, Ergebnis ueber Action 'close_overlay' raus.",
        "⚠️ Das Overlay-Projekt beendet sich ueber die Action 'close_overlay' mit result-JSON; die Felder stehen in onOverlayResult als ${…} bereit.",
        "⚠️ Die Komponenten-Box ist die Karte — Groesse/Position wie bei jedem Objekt im Inspector einstellen."
      ]
    },
    "TInlineOverlay": {
      "description": "Platzierbare, interaktive Inline-Einblendung. Anders als TOverlay (iframe mit Fremdprojekt) wird sie direkt in der Stage gerendert, kennt zwei Geometrien (kompakt + expandedBounds) und pausiert den GameLoop nicht automatisch.",
      "stage": "main",
      "category": "ui",
      "properties": {
        "expanded": {
          "type": "boolean",
          "default": false,
          "description": "Startzustand: kompakt (false) oder aufgeklappt (true)"
        },
        "expandedBounds": {
          "type": "object",
          "default": null,
          "description": "Geometrie im aufgeklappten Zustand {x,y,width,height}; null = kompakte Geometrie als Fallback"
        },
        "interactionMode": {
          "type": "select",
          "default": "interactive",
          "options": [
            "interactive",
            "passive"
          ],
          "description": "interactive = klickbar/fokussierbar; passive = reine Anzeige, Klicks gehen durch"
        },
        "activationAction": {
          "type": "select",
          "default": "toggle",
          "options": [
            "toggle",
            "expand",
            "collapse",
            "eventOnly"
          ],
          "description": "Reaktion auf Aktivierung; eventOnly feuert nur onClick ohne eingebaute Aktion"
        },
        "modal": {
          "type": "boolean",
          "default": false,
          "description": "Nur wenn expanded: Rest der Stage blockieren (Backdrop)"
        },
        "pausesGame": {
          "type": "boolean",
          "default": false,
          "description": "GameLoop pausieren, solange aufgeklappt; wird nur von dieser Komponente wieder freigegeben"
        },
        "closable": {
          "type": "boolean",
          "default": true,
          "description": "Schließen-Button im aufgeklappten Zustand"
        },
        "backdropColor": {
          "type": "color",
          "default": "rgba(0,0,0,0.45)",
          "description": "Backdrop-Farbe bei modal"
        },
        "ariaLabel": {
          "type": "string",
          "default": "",
          "description": "Barrierefreie Beschriftung"
        }
      },
      "methods": [
        {
          "name": "show",
          "description": "Einblendung sichtbar machen"
        },
        {
          "name": "hide",
          "description": "Einblendung ausblenden"
        },
        {
          "name": "expand",
          "description": "Aufklappen (feuert onExpanded)"
        },
        {
          "name": "collapse",
          "description": "Zuklappen (feuert onCollapsed)"
        },
        {
          "name": "toggleExpanded",
          "description": "Zwischen kompakt und aufgeklappt wechseln"
        }
      ],
      "events": [
        "onClick",
        "onExpanded",
        "onCollapsed"
      ],
      "example": {
        "className": "TInlineOverlay",
        "name": "HintOverlay",
        "x": 1,
        "y": 1,
        "width": 8,
        "height": 2,
        "expandedBounds": {
          "x": 4,
          "y": 3,
          "width": 20,
          "height": 10
        },
        "interactionMode": "interactive",
        "activationAction": "toggle",
        "modal": false
      },
      "warnings": [
        "⚠️ Kein iframe: Inhalte kommen aus derselben Stage — kein Fremdprojekt möglich.",
        "⚠️ modal + pausesGame sind getrennte Eigenschaften; Pause nur mit pausesGame.",
        "⚠️ expandedBounds ist Designwert und wird vom Editor separat editiert (gestrichelter Rahmen)."
      ]
    }
  }
}
