          "className": "TStringVariable",
          "initialValue": "",
          "defaultValue": "",
          "value": "",
          "scope": "global"
        },
        {
          "name": "Slot2",
          "type": "string",
          "isVariable": true,
          "className": "TStringVariable",
          "initialValue": "",
          "defaultValue": "",
          "value": "",
          "scope": "global"
        },
        {
          "name": "Slot3",
          "type": "string",
          "isVariable": true,
          "className": "TStringVariable",
          "initialValue": "",
          "defaultValue": "",
          "value": "",
          "scope": "global"
        }
      ],
      "flowCharts": {},
      "events": {},
      "grid": {
        "cols": 64,
        "rows": 48,
        "cellSize": 18,
        "visible": false,
        "backgroundColor": "#122b39"
      }
    },
