          "initialValue": 0,
          "defaultValue": 0,
          "value": 0,
          "scope": "global"
        },
        {
          "name": "Slot0",
          "type": "string",
          "isVariable": true,
          "className": "TStringVariable",
          "initialValue": "",
          "defaultValue": "",
          "value": "",
          "scope": "global"
        },
        {
          "name": "Slot1",
          "type": "string",
