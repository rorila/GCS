   "tasks": [
    {
     "id": "q_task-3f219049-e62c-4426-a537-44036b49c26e",
     "name": "Quiz_Start",
     "description": "Erstladung: erste Karte aus dem Karteikasten ordern",
     "actionSequence": [
      {
       "type": "task",
       "name": "Karte_Ziehen"
      }
     ],
     "triggerMode": "local-sync",
     "params": [],
     "scope": "stage"
    },
    {
     "id": "q_task-d2d85ebd-cff3-486e-8842-e957fedd01c9",
     "name": "Karte_Ziehen",
     "description": "Server ordert die nächste Karte: Fach aufsteigend, je Fach älteste zuerst",
     "actionSequence": [
      {
       "type": "condition",
       "name": "Runde läuft?",
       "condition": {
        "variable": "Busy",
        "operator": "==",
        "value": 0
       },
       "body": [
        {
         "type": "action",
         "name": "Act_Ziehen_Start"
        },
        {
         "type": "action",
         "name": "Act_Karte_Server"
        },
        {
         "type": "condition",
         "name": "Server antwortet?",
         "condition": {
          "variable": "KartenAntwort.ok",
          "operator": "!=",
          "value": true
         },
         "body": [
          {
           "type": "action",
           "name": "Act_ZiehFehler"
          }
         ],
         "elseBody": [
          {
           "type": "condition",
           "name": "Karte gefunden?",
           "condition": {
            "variable": "KartenAntwort.card",
            "operator": "truthy",
            "value": true
           },
           "body": [
            {
             "type": "action",
             "name": "Act_Karte_Objekt"
            },
            {
             "type": "action",
             "name": "Act_Karte_Uebernehmen"
            },
            {
             "type": "condition",
             "name": "Eingabe-Format?",
             "condition": {
              "variable": "KartenAntwort.card.answerFormat",
              "operator": "==",
              "value": "text"
             },
             "body": [
              {
               "type": "action",
               "name": "Act_TextBereit"
              }
             ],
             "elseBody": [
              {
               "type": "action",
               "name": "Act_SelfBereit"
              }
             ]
            }
           ],
           "elseBody": [
            {
             "type": "action",
             "name": "Act_QuizEnde"
            }
           ]
          }
         ]
        }
       ]
      }
     ],
     "triggerMode": "local-sync",
     "params": [],
     "scope": "stage"
    },
    {
     "id": "q_task-04c9692f-052e-4db0-ae4f-d5470adaae31",
     "name": "Antwort_Pruefen",
     "description": "Texteingabe gegen answers-Array prüfen (case-sensitiv; Varianten einzeln hinterlegen)",
     "actionSequence": [
      {
       "type": "condition",
       "name": "Antwort akzeptiert?",
       "condition": {
        "variable": "AntwortEdit.text",
        "operator": "in",
        "value": "${AktuelleKarte.answers}"
       },
       "body": [
        {
         "type": "task",
         "name": "Bewerten_Richtig"
        }
       ],
       "elseBody": [
        {
         "type": "task",
         "name": "Bewerten_Falsch"
        }
       ]
      }
     ],
     "triggerMode": "local-sync",
     "params": [],
     "scope": "stage"
    },
    {
     "id": "q_task-129928b9-b855-4968-8ab2-d222e59a3fa2",
     "name": "Antwort_Zeigen",
     "description": "Selbstbewertung: Lösung aufdecken, Richtig/Falsch-Buttons",
     "actionSequence": [
      {
       "type": "action",
       "name": "Act_Loesung_Anzeigen"
      }
     ],
     "triggerMode": "local-sync",
