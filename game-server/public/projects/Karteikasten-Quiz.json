   "tasks": [
    {
     "id": "q_task-ebf14905-b3d2-4484-8ac7-2122e4f828b6",
     "name": "Quiz_Start",
     "description": "Erstladung: erste Karte aus dem Karteikasten ordern",
     "actionSequence": [
      {
       "type": "task",
       "name": "Karte_Ziehen"
      }
     ],
     "triggerMode": "local-sync",
     "params": [],
     "scope": "stage"
    },
    {
     "id": "q_task-fff411b3-06d3-4676-a6e3-5f6430aa539b",
     "name": "Karte_Ziehen",
     "description": "Server ordert die nächste Karte: Fach aufsteigend, je Fach älteste zuerst",
     "actionSequence": [
      {
       "type": "condition",
       "name": "Runde läuft?",
       "condition": {
        "variable": "Busy",
        "operator": "==",
        "value": 0
       },
       "body": [
        {
         "type": "action",
         "name": "Act_Ziehen_Start"
        },
        {
         "type": "action",
         "name": "Act_Karte_Server"
        },
        {
         "type": "condition",
         "name": "Karte gefunden?",
         "condition": {
          "variable": "KartenAntwort.card",
          "operator": "truthy",
          "value": true
         },
         "body": [
          {
           "type": "action",
           "name": "Act_Karte_Uebernehmen"
          },
          {
           "type": "condition",
           "name": "Eingabe-Format?",
           "condition": {
            "variable": "KartenAntwort.card.answerFormat",
            "operator": "==",
            "value": "text"
           },
           "body": [
            {
             "type": "action",
             "name": "Act_TextBereit"
            }
           ],
           "elseBody": [
            {
             "type": "action",
             "name": "Act_SelfBereit"
            }
           ]
          }
         ],
         "elseBody": [
          {
           "type": "action",
           "name": "Act_QuizEnde"
          }
         ]
        }
       ]
      }
     ],
     "triggerMode": "local-sync",
     "params": [],
     "scope": "stage"
    },
    {
     "id": "q_task-7ad8cda4-42f8-4868-a63a-4f3c9a180af9",
     "name": "Antwort_Pruefen",
     "description": "Texteingabe gegen answers-Array prüfen (case-sensitiv; Varianten einzeln hinterlegen)",
     "actionSequence": [
      {
       "type": "condition",
       "name": "Antwort akzeptiert?",
       "condition": {
        "variable": "AntwortEdit.text",
        "operator": "in",
        "value": "${AktuelleKarte.answers}"
       },
       "body": [
        {
         "type": "task",
         "name": "Bewerten_Richtig"
        }
       ],
       "elseBody": [
        {
         "type": "task",
         "name": "Bewerten_Falsch"
        }
       ]
      }
     ],
     "triggerMode": "local-sync",
     "params": [],
     "scope": "stage"
    },
    {
     "id": "q_task-a8f25bb1-bc0e-4a56-9c2a-a3ea3615a7cf",
     "name": "Antwort_Zeigen",
