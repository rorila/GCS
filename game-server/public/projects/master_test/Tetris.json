            {
              "type": "action",
              "name": "Act_SteuerungRechts"
            }
          ],
          "triggerMode": "local-sync",
          "params": [],
          "id": "tetris_task_rechts"
        },
        {
          "name": "SteinDrehen",
          "description": "Dreht den aktiven Stein im Uhrzeigersinn (mit Wall-Kicks).",
          "actionSequence": [
            {
              "name": "Act_SteinDrehen",
              "type": "action"
            }
          ],
          "triggerMode": "local-sync",
          "params": [],
          "id": "tetris_task_drehen",
          "flowLayout": {
            "SteinDrehen": {
              "x": 40,
              "y": 40
            },
            "Act_SteinDrehen": {
              "x": 40,
              "y": 140
            }
          }
        },
        {
          "name": "SteinSenken",
          "description": "Senkt den aktiven Stein eine Zeile (Soft Drop, +1 Punkt).",
          "actionSequence": [
            {
              "type": "action",
              "name": "Act_SteinSenken"
            }
          ],
          "triggerMode": "local-sync",
          "params": [],
          "id": "tetris_task_senken"
        },
        {
          "name": "SteinFallen",
          "description": "Lässt den aktiven Stein sofort fallen (Hard Drop, +2 Punkte je Zeile).",
          "actionSequence": [
            {
              "type": "action",
              "name": "Act_SteinFallen"
            }
          ],
          "triggerMode": "local-sync",
          "params": [],
          "id": "tetris_task_fallen"
        },
        {
          "name": "StartOderDrop",
          "description": "Leertaste: Im Spiel Hard Drop, in Pause fortsetzen, sonst neue Runde starten.",
          "actionSequence": [
            {
              "type": "condition",
              "name": "Branch: Spielfeld.state == playing",
              "condition": {
                "variable": "Spielfeld.state",
                "operator": "==",
                "value": "playing"
              },
              "then": [
                {
                  "type": "task",
                  "name": "SteinFallen"
                }
              ],
              "else": [
                {
                  "type": "condition",
                  "name": "Branch: Spielfeld.state == paused",
                  "condition": {
                    "variable": "Spielfeld.state",
                    "operator": "==",
                    "value": "paused"
                  },
                  "then": [
                    {
                      "type": "task",
                      "name": "PauseWechsel"
                    }
                  ],
                  "else": [
                    {
                      "type": "task",
                      "name": "SpielStarten"
                    }
                  ]
                }
              ]
            }
          ],
          "triggerMode": "local-sync",
          "params": [],
          "id": "tetris_task_startoderdrop"
        }
      ],
