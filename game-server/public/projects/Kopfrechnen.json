                      "type": "task",
                      "name": "NeueAufgabe"
                    }
                  ]
                }
              ],
              "elseBody": [
                {
                  "name": "Fehler zaehlen",
                  "type": "action"
                },
                {
                  "name": "Feedback Fast",
                  "type": "action"
                }
