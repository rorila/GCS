      "tasks": [
        {
          "params": [],
          "triggerMode": "local-sync",
          "name": "NeueAufgabe",
          "description": "Zaehlt AufgabenNr hoch, wuerfelt A (1-19) und B (0 bis 20-A), zeigt die Aufgabe und verteilt die richtige Antwort per ZufallPos auf einen der drei Buttons.",
          "actionSequence": [
            {
              "name": "AufgabenNr hochzaehlen",
              "type": "action"
            },
            {
              "name": "Zahl A wuerfeln",
              "type": "action"
            },
            {
              "name": "B-Maximum aus A",
              "type": "action"
            },
            {
              "name": "Zahl B wuerfeln",
              "type": "action"
            },
            {
              "name": "Ergebnis berechnen",
              "type": "action"
            },
            {
              "name": "Aufgabe zeigen",
              "type": "action"
            },
            {
              "name": "Distraktor 1 berechnen",
              "type": "action"
            },
            {
              "name": "Distraktor 2 berechnen",
              "type": "action"
            },
            {
              "name": "Position wuerfeln",
              "type": "action"
            },
            {
              "condition": {
                "variable": "Pos",
                "operator": "==",
                "value": 1
              },
              "type": "condition",
              "body": [
                {
                  "name": "Antworten Variante A",
                  "type": "action"
                }
              ],
              "elseBody": [
                {
                  "condition": {
                    "variable": "Pos",
                    "operator": "==",
                    "value": 2
                  },
                  "type": "condition",
                  "body": [
                    {
                      "name": "Antworten Variante B",
                      "type": "action"
                    }
                  ],
                  "elseBody": [
                    {
                      "condition": {
                        "variable": "Pos",
                        "operator": "==",
                        "value": 3
                      },
                      "type": "condition",
                      "body": [
                        {
                          "name": "Antworten Variante C",
                          "type": "action"
                        }
                      ],
                      "elseBody": []
                    }
                  ]
                }
              ]
