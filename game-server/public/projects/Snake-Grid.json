        }
      ],
      "tasks": [
        {
          "name": "SpielStarten",
          "description": "Neue Runde: Board leeren, Schlange auf Startposition, Futter legen, Takt an.",
          "actionSequence": [
            {
              "type": "action",
              "name": "Act_BoardLeeren"
            },
            {
              "type": "action",
              "name": "Act_TextAus"
            },
            {
              "type": "action",
              "name": "Act_StartWerte"
            },
            {
              "type": "action",
              "name": "Act_ListeLeerX"
            },
            {
              "type": "action",
              "name": "Act_ListeLeerY"
            },
            {
              "type": "action",
              "name": "Act_StartPushX"
            },
            {
              "type": "action",
              "name": "Act_StartPushY"
            },
            {
              "type": "action",
              "name": "Act_StartKopf"
            },
            {
              "type": "task",
              "name": "FutterNeu"
            },
            {
              "type": "action",
              "name": "Act_TaktAn"
            }
          ],
          "triggerMode": "local-sync",
          "params": [],
          "id": "sg_spielstarten"
        },
        {
          "name": "Ticken",
          "description": "Takt: Richtung anwenden und Schritt ausfuehren.",
          "actionSequence": [
            {
              "type": "condition",
              "name": "Branch: Status == playing",
              "condition": {
                "variable": "Status",
                "operator": "==",
                "value": "playing"
              },
              "then": [
                {
                  "type": "action",
                  "name": "Act_RichtungAnwenden"
                },
                {
                  "type": "action",
                  "name": "Act_NeuX"
                },
                {
                  "type": "action",
                  "name": "Act_NeuY"
                },
                {
                  "type": "action",
                  "name": "Act_ZelleLesen"
                },
                {
                  "type": "condition",
                  "name": "Branch: ZellWert == 2",
                  "condition": {
                    "variable": "ZellWert",
                    "operator": "==",
                    "value": 2
                  },
                  "then": [
                    {
                      "type": "task",
                      "name": "Fressen"
                    }
                  ],
                  "else": [
                    {
                      "type": "condition",
                      "name": "Branch: ZellWert == 0",
                      "condition": {
                        "variable": "ZellWert",
                        "operator": "==",
                        "value": 0
                      },
                      "then": [
                        {
                          "type": "task",
                          "name": "Bewegen"
                        }
                      ],
                      "else": [
                        {
                          "type": "task",
                          "name": "SpielEnde"
                        }
                      ]
                    }
                  ]
                }
              ],
              "else": []
            }
          ],
          "triggerMode": "local-sync",
          "params": [],
          "id": "sg_ticken"
        },
        {
          "name": "Bewegen",
          "description": "Normaler Schritt: Kopf vor, Schwanz weg.",
          "actionSequence": [
            {
              "type": "action",
              "name": "Act_KopfAlt"
            },
            {
              "type": "action",
              "name": "Act_KopfPushX"
            },
            {
              "type": "action",
              "name": "Act_KopfPushY"
            },
            {
              "type": "action",
              "name": "Act_TailPopX"
            },
            {
              "type": "action",
              "name": "Act_TailPopY"
            },
            {
              "type": "action",
              "name": "Act_SchwanzWeg"
            },
            {
              "type": "action",
              "name": "Act_KopfSetzen"
            },
            {
              "type": "action",
              "name": "Act_KopfNeu"
            }
          ],
          "triggerMode": "local-sync",
          "params": [],
          "id": "sg_bewegen"
        },
        {
          "name": "Fressen",
          "description": "Futter erreicht: wachsen, Punkte, neues Futter.",
          "actionSequence": [
            {
              "type": "action",
              "name": "Act_KopfAlt"
            },
            {
              "type": "action",
              "name": "Act_KopfPushX"
            },
            {
              "type": "action",
              "name": "Act_KopfPushY"
            },
            {
              "type": "action",
              "name": "Act_KopfSetzen"
            },
            {
              "type": "action",
              "name": "Act_KopfNeu"
            },
            {
              "type": "action",
              "name": "Act_ScorePlus"
            },
            {
              "type": "action",
              "name": "Act_LaengePlus"
            },
            {
              "type": "task",
              "name": "FutterNeu"
            }
          ],
          "triggerMode": "local-sync",
          "params": [],
          "id": "sg_fressen"
        },
        {
          "name": "FutterNeu",
          "description": "Zufaellige freie Zelle fuer das Futter suchen.",
          "actionSequence": [
            {
              "type": "action",
              "name": "Act_ZufallX"
            },
            {
              "type": "action",
              "name": "Act_ZufallY"
            },
            {
              "type": "action",
              "name": "Act_FutterX"
            },
            {
              "type": "action",
              "name": "Act_FutterY"
            },
            {
              "type": "action",
              "name": "Act_FutterLesen"
            },
            {
              "type": "while",
              "name": "While: Belegt != 0",
              "condition": {
                "variable": "Belegt",
                "operator": "!=",
                "value": 0
              },
              "body": [
                {
                  "type": "action",
                  "name": "Act_ZufallX"
                },
                {
                  "type": "action",
                  "name": "Act_ZufallY"
                },
                {
                  "type": "action",
                  "name": "Act_FutterX"
                },
                {
                  "type": "action",
                  "name": "Act_FutterY"
                },
                {
                  "type": "action",
                  "name": "Act_FutterLesen"
                }
              ]
            },
            {
              "type": "action",
              "name": "Act_FutterSetzen"
            }
          ],
          "triggerMode": "local-sync",
          "params": [],
          "id": "sg_futterneu"
        },
        {
          "name": "RichtungLinks",
          "description": "Wunsch nach links (nicht aus Rechtslauf).",
          "actionSequence": [
            {
              "type": "condition",
              "name": "Branch: Status == playing",
              "condition": {
                "variable": "Status",
                "operator": "==",
                "value": "playing"
              },
              "then": [
                {
                  "type": "condition",
                  "name": "Branch: Abgebogen == 0",
                  "condition": {
                    "variable": "Abgebogen",
                    "operator": "==",
                    "value": 0
                  },
                  "then": [
                    {
                      "type": "condition",
                      "name": "Branch: DX != 1",
                      "condition": {
                        "variable": "DX",
                        "operator": "!=",
                        "value": 1
                      },
                      "then": [
                        {
                          "type": "action",
                          "name": "Act_WunschLinks"
                        }
                      ],
                      "else": []
                    }
                  ],
                  "else": []
                }
              ],
              "else": []
            }
          ],
          "triggerMode": "local-sync",
          "params": [],
          "id": "sg_richtunglinks"
        },
        {
          "name": "RichtungRechts",
          "description": "Wunsch nach rechts (nicht aus Linkslauf).",
          "actionSequence": [
            {
              "type": "condition",
              "name": "Branch: Status == playing",
              "condition": {
                "variable": "Status",
                "operator": "==",
                "value": "playing"
              },
              "then": [
                {
                  "type": "condition",
                  "name": "Branch: Abgebogen == 0",
                  "condition": {
                    "variable": "Abgebogen",
                    "operator": "==",
                    "value": 0
                  },
                  "then": [
                    {
                      "type": "condition",
                      "name": "Branch: DX != -1",
                      "condition": {
                        "variable": "DX",
                        "operator": "!=",
                        "value": -1
                      },
                      "then": [
                        {
                          "type": "action",
                          "name": "Act_WunschRechts"
                        }
                      ],
                      "else": []
                    }
                  ],
                  "else": []
                }
              ],
              "else": []
            }
          ],
          "triggerMode": "local-sync",
          "params": [],
          "id": "sg_richtungrechts"
        },
        {
          "name": "RichtungOben",
          "description": "Wunsch nach oben (nicht aus Abwaertslauf).",
          "actionSequence": [
            {
              "type": "condition",
              "name": "Branch: Status == playing",
              "condition": {
                "variable": "Status",
                "operator": "==",
                "value": "playing"
              },
              "then": [
                {
                  "type": "condition",
                  "name": "Branch: Abgebogen == 0",
                  "condition": {
                    "variable": "Abgebogen",
                    "operator": "==",
                    "value": 0
                  },
                  "then": [
                    {
                      "type": "condition",
                      "name": "Branch: DY != 1",
                      "condition": {
                        "variable": "DY",
                        "operator": "!=",
                        "value": 1
                      },
                      "then": [
                        {
                          "type": "action",
                          "name": "Act_WunschOben"
                        }
                      ],
                      "else": []
                    }
                  ],
                  "else": []
                }
              ],
              "else": []
            }
          ],
          "triggerMode": "local-sync",
          "params": [],
          "id": "sg_richtungoben"
        },
        {
          "name": "RichtungUnten",
          "description": "Wunsch nach unten (nicht aus Aufwaertslauf).",
          "actionSequence": [
            {
              "type": "condition",
              "name": "Branch: Status == playing",
              "condition": {
                "variable": "Status",
                "operator": "==",
                "value": "playing"
              },
              "then": [
                {
                  "type": "condition",
                  "name": "Branch: Abgebogen == 0",
                  "condition": {
                    "variable": "Abgebogen",
                    "operator": "==",
                    "value": 0
                  },
                  "then": [
                    {
                      "type": "condition",
                      "name": "Branch: DY != -1",
                      "condition": {
                        "variable": "DY",
                        "operator": "!=",
                        "value": -1
                      },
                      "then": [
                        {
                          "type": "action",
                          "name": "Act_WunschUnten"
                        }
                      ],
                      "else": []
                    }
                  ],
                  "else": []
                }
              ],
              "else": []
            }
          ],
          "triggerMode": "local-sync",
          "params": [],
          "id": "sg_richtungunten"
        },
        {
          "name": "PauseWechsel",
          "description": "Pause umschalten.",
          "actionSequence": [
            {
              "type": "condition",
              "name": "Branch: Status == playing",
              "condition": {
                "variable": "Status",
                "operator": "==",
                "value": "playing"
              },
              "then": [
                {
                  "type": "action",
                  "name": "Act_StatusPause"
                },
                {
                  "type": "action",
                  "name": "Act_TaktAus"
                },
                {
                  "type": "action",
                  "name": "Act_TextPause"
                }
              ],
              "else": [
                {
                  "type": "condition",
                  "name": "Branch: Status == paused",
                  "condition": {
                    "variable": "Status",
                    "operator": "==",
                    "value": "paused"
                  },
                  "then": [
                    {
                      "type": "action",
                      "name": "Act_StatusWeiter"
                    },
                    {
                      "type": "action",
                      "name": "Act_TextAus"
                    },
                    {
                      "type": "action",
                      "name": "Act_TaktAn"
                    }
                  ],
                  "else": []
                }
              ]
            }
          ],
          "triggerMode": "local-sync",
          "params": [],
          "id": "sg_pausewechsel"
        },
        {
          "name": "StartOderNeu",
          "description": "Leertaste: in Pause fortsetzen, sonst neue Runde starten.",
          "actionSequence": [
            {
              "type": "condition",
              "name": "Branch: Status == paused",
              "condition": {
                "variable": "Status",
                "operator": "==",
                "value": "paused"
              },
              "then": [
                {
                  "type": "task",
                  "name": "PauseWechsel"
                }
              ],
              "else": [
                {
                  "type": "condition",
                  "name": "Branch: Status != playing",
                  "condition": {
                    "variable": "Status",
                    "operator": "!=",
                    "value": "playing"
                  },
                  "then": [
                    {
                      "type": "task",
                      "name": "SpielStarten"
                    }
                  ],
                  "else": []
                }
              ]
            }
          ],
          "triggerMode": "local-sync",
          "params": [],
          "id": "sg_startoderneu"
        },
        {
          "name": "SpielEnde",
          "description": "Game Over: Takt aus und Hinweis zeigen.",
          "actionSequence": [
            {
              "type": "action",
              "name": "Act_StatusEnde"
            },
            {
              "type": "action",
              "name": "Act_TaktAus"
            },
            {
              "type": "action",
              "name": "Act_TextGameOver"
            }
          ],
          "triggerMode": "local-sync",
          "params": [],
