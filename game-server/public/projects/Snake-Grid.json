            "KopfY": 6,
            "DX": 1,
            "DY": 0,
            "WunschDX": 1,
            "WunschDY": 0,
            "Abgebogen": 0
          }
        },
        {
          "name": "Act_TaktAn",
          "type": "property",
          "changes": {
            "Takt.enabled": true
          }
        },
        {
          "name": "Act_TaktAus",
          "type": "property",
          "changes": {
            "Takt.enabled": false
          }
        },
        {
          "name": "Act_StatusPause",
          "type": "property",
          "changes": {
            "Status": "paused"
          }
        },
        {
          "name": "Act_StatusWeiter",
          "type": "property",
          "changes": {
            "Status": "playing"
          }
        },
        {
          "name": "Act_StatusEnde",
          "type": "property",
          "changes": {
            "Status": "gameover"
          }
        },
        {
          "name": "Act_WunschLinks",
          "type": "property",
          "changes": {
