{
  "meta": {
    "id": "snake-grid",
    "name": "Snake Grid",
    "version": "1.0.0",
    "author": "Rolf Rieckmann / Devin",
    "description": "Snake auf TGridBoard-Basis: 16x12 Raster, Positionslisten statt Sprites, Kollision per getCell."
  },
  "stage": {
    "grid": {
      "cols": 64,
      "rows": 40,
      "cellSize": 18,
      "visible": false,
      "snapToGrid": true,
      "backgroundColor": "#08151b"
