      "actions": [
        {
          "name": "Act_BoardLeeren",
          "type": "call_method",
          "target": "Spielfeld",
          "method": "clearBoard",
          "params": []
        },
        {
          "name": "Act_TextAus",
          "type": "call_method",
          "target": "Spielfeld",
          "method": "setOverlayText",
          "params": [
            ""
          ]
        },
        {
          "name": "Act_TextPause",
          "type": "call_method",
          "target": "Spielfeld",
          "method": "setOverlayText",
          "params": [
            "⏸ PAUSE\nP = weiter"
          ]
        },
        {
          "name": "Act_TextGameOver",
          "type": "call_method",
          "target": "Spielfeld",
          "method": "setOverlayText",
          "params": [
            "GAME OVER\nScore: ${Score}\n↻ Leertaste = neu"
          ]
        },
        {
          "name": "Act_KopfSetzen",
          "type": "call_method",
          "target": "Spielfeld",
          "method": "setCell",
          "params": [
            "${NeuX}",
            "${NeuY}",
            "3"
          ]
        },
        {
          "name": "Act_KopfAlt",
          "type": "call_method",
          "target": "Spielfeld",
          "method": "setCell",
          "params": [
            "${KopfX}",
            "${KopfY}",
            "1"
          ]
        },
        {
          "name": "Act_SchwanzWeg",
          "type": "call_method",
          "target": "Spielfeld",
          "method": "setCell",
          "params": [
            "${TailX}",
            "${TailY}",
            "0"
          ]
        },
        {
          "name": "Act_StartKopf",
          "type": "call_method",
          "target": "Spielfeld",
          "method": "setCell",
          "params": [
            "${KopfX}",
            "${KopfY}",
            "3"
          ]
        },
        {
          "name": "Act_ZelleLesen",
          "type": "call_method",
          "target": "Spielfeld",
          "method": "getCell",
          "params": [
            "${NeuX}",
            "${NeuY}"
          ],
          "resultVariable": "ZellWert"
        },
        {
          "name": "Act_FutterLesen",
          "type": "call_method",
          "target": "Spielfeld",
          "method": "getCell",
          "params": [
            "${FutterX}",
            "${FutterY}"
          ],
          "resultVariable": "Belegt"
        },
        {
          "name": "Act_FutterSetzen",
          "type": "call_method",
          "target": "Spielfeld",
          "method": "setCell",
          "params": [
            "${FutterX}",
            "${FutterY}",
            "2"
          ]
        },
        {
          "name": "Act_ZufallX",
          "type": "call_method",
          "target": "ZufallX",
          "method": "generate",
          "params": []
        },
        {
          "name": "Act_ZufallY",
          "type": "call_method",
          "target": "ZufallY",
          "method": "generate",
          "params": []
        },
        {
          "name": "Act_FutterX",
          "type": "property",
          "changes": {
            "FutterX": "${ZufallX}"
          }
        },
        {
          "name": "Act_FutterY",
          "type": "property",
          "changes": {
            "FutterY": "${ZufallY}"
          }
        },
        {
          "name": "Act_KopfPushX",
          "type": "list_push",
          "target": "SchlangeX",
          "value": "${NeuX}"
        },
        {
          "name": "Act_KopfPushY",
          "type": "list_push",
          "target": "SchlangeY",
          "value": "${NeuY}"
        },
        {
          "name": "Act_StartPushX",
          "type": "list_push",
          "target": "SchlangeX",
          "value": "${KopfX}"
        },
        {
          "name": "Act_StartPushY",
          "type": "list_push",
          "target": "SchlangeY",
          "value": "${KopfY}"
        },
        {
          "name": "Act_TailPopX",
          "type": "list_remove",
          "target": "SchlangeX",
          "index": "0",
          "resultVariable": "TailX"
        },
        {
          "name": "Act_TailPopY",
          "type": "list_remove",
          "target": "SchlangeY",
          "index": "0",
          "resultVariable": "TailY"
        },
        {
          "name": "Act_ListeLeerX",
          "type": "list_clear",
          "target": "SchlangeX"
        },
        {
          "name": "Act_ListeLeerY",
          "type": "list_clear",
          "target": "SchlangeY"
        },
        {
          "name": "Act_NeuX",
          "type": "calculate",
          "formula": "KopfX + DX",
          "resultVariable": "NeuX"
        },
        {
          "name": "Act_NeuY",
          "type": "calculate",
          "formula": "KopfY + DY",
          "resultVariable": "NeuY"
        },
        {
          "name": "Act_ScorePlus",
          "type": "calculate",
          "formula": "Score + 10",
          "resultVariable": "Score"
        },
        {
          "name": "Act_LaengePlus",
          "type": "calculate",
          "formula": "Laenge + 1",
          "resultVariable": "Laenge"
        },
        {
          "name": "Act_RichtungAnwenden",
          "type": "property",
          "changes": {
            "DX": "${WunschDX}",
            "DY": "${WunschDY}"
          }
        },
        {
          "name": "Act_KopfNeu",
          "type": "property",
          "changes": {
