   "tasks": [
    {
     "id": "kr_task-09ba34cc-1bd8-4658-a616-85671d8a7875",
     "name": "App_Start",
     "description": "Erstladung: erste Karte aus dem Karteikasten ordern",
     "actionSequence": [
      {
       "type": "condition",
       "condition": {
        "variable": "Phase",
        "operator": "==",
        "value": "idle"
       },
       "body": [
        {
         "type": "action",
         "name": "Act_Start_Auswahl"
        },
        {
         "type": "task",
         "name": "Aufgabe_Ziehen"
        }
       ],
       "elseBody": []
      }
     ],
     "triggerMode": "local-sync",
     "params": [],
     "scope": "stage"
    },
    {
     "id": "kr_task-dcb00813-fb16-447f-ae85-78cf58154c50",
     "name": "Aufgabe_Ziehen",
     "description": "Server ordert die nächste Karte; Distraktoren = Ergebnis±1 bzw. +2, Position zufällig",
     "actionSequence": [
      {
       "type": "condition",
       "condition": {
        "variable": "Phase",
        "operator": "==",
        "value": "next"
       },
       "body": [
        {
         "type": "condition",
         "condition": {
          "variable": "AufgabenNr",
          "operator": ">=",
          "value": "${Aufgaben}",
          "rightType": "variable"
         },
         "body": [
          {
           "type": "task",
           "name": "Abschluss"
          }
         ],
         "elseBody": [
          {
           "type": "action",
           "name": "Act_Ziehen_Start"
          },
          {
           "type": "action",
           "name": "Act_Karte_Server"
          },
          {
           "type": "condition",
           "condition": {
            "variable": "Phase",
            "operator": "==",
            "value": "loading"
           },
           "body": [
            {
             "type": "condition",
             "condition": {
              "variable": "KartenAntwort.ok",
              "operator": "==",
              "value": true
             },
             "body": [
              {
               "type": "condition",
               "condition": {
                "variable": "KartenAntwort.card",
                "operator": "truthy",
                "value": true
               },
               "body": [
                {
                 "type": "action",
                 "name": "Act_Karte_Objekt"
                },
                {
                 "type": "action",
                 "name": "Act_Auswahl_Erzeugen"
                },
                {
                 "type": "condition",
                 "condition": {
                  "variable": "Auswahl.valid",
                  "operator": "==",
                  "value": true
                 },
                 "body": [
                  {
                   "type": "action",
                   "name": "Act_Nr_Plus"
                  },
                  {
                   "type": "action",
                   "name": "Act_Auswahl_Bereit"
                  }
                 ],
                 "elseBody": [
                  {
                   "type": "action",
                   "name": "Act_Auswahl_Fehler"
                  }
                 ]
                }
               ],
               "elseBody": [
                {
                 "type": "task",
                 "name": "Abschluss"
                }
               ]
              }
             ],
             "elseBody": [
              {
               "type": "action",
               "name": "Act_ZiehFehler"
              }
             ]
            }
           ],
           "elseBody": []
          }
         ]
        }
       ],
       "elseBody": []
      }
     ],
     "triggerMode": "local-sync",
     "params": [],
     "scope": "stage"
    },
    {
     "id": "kr_task-45ad86a0-073e-4213-9f69-dd385bb91d30",
     "name": "Antwort_Gewaehlt",
     "description": "matchValue des geklickten Buttons mit dem Ergebnis vergleichen",
     "actionSequence": [
      {
       "type": "condition",
       "condition": {
        "variable": "Phase",
        "operator": "==",
        "value": "answering"
       },
       "body": [
        {
         "type": "action",
         "name": "Act_Antwort_Sperren"
        },
        {
         "type": "action",
         "name": "Act_Antwort_Uebernehmen"
        },
        {
         "type": "action",
         "name": "Act_Antwort_Pruefen"
        },
        {
         "type": "condition",
         "condition": {
          "variable": "AntwortPruefung.correct",
          "operator": "==",
          "value": true
         },
         "body": [
          {
           "type": "task",
           "name": "Bewerten_Richtig"
          }
         ],
         "elseBody": [
          {
           "type": "task",
           "name": "Bewerten_Falsch"
          }
         ]
        }
       ],
       "elseBody": []
      }
     ],
     "triggerMode": "local-sync",
     "params": [],
     "scope": "stage"
    },
    {
