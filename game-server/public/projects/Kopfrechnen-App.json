   "actions": [
    {
     "id": "kr_act-1a5ac02e-242c-4d2f-871c-d3075f9a69db",
     "name": "Act_Ziehen_Start",
     "type": "property",
     "changes": {
      "Phase": "loading",
      "Busy": 1,
      "BtnAntwortA.visible": false,
      "BtnAntwortB.visible": false,
      "BtnAntwortC.visible": false,
      "BtnAntwortA.enabled": false,
      "BtnAntwortB.enabled": false,
      "BtnAntwortC.enabled": false,
      "StatusLabel.text": "Aufgabe wird geladen …",
      "LoesungLabel.text": "",
      "Naechste.visible": false,
      "AntwortTimer.enabled": false,
      "AktuelleAntwort": ""
     },
     "scope": "stage"
    },
    {
     "id": "kr_act-4314ad8f-61c9-4987-b2d9-0e1baaeff3d1",
     "name": "Act_Karte_Server",
     "type": "http",
     "url": "/api/cms/play",
     "method": "POST",
     "body": {
      "launchKey": "${CMS_LAUNCH}",
      "action": "cardNext",
      "subject": "${KartenFach}",
      "topic": "${KartenThema}",
      "formats": [
       "text"
      ],
      "excludeIds": "${GezogeneIds}",
      "learningPoints": true
     },
     "resultVariable": "KartenAntwort",
     "scope": "stage",
     "queryOperator": "=="
    },
    {
     "id": "kr_act-a28d8fcb-34ff-49ae-8388-2a79ff06dbbe",
     "name": "Act_ZiehFehler",
     "type": "property",
     "changes": {
      "Phase": "load-error",
      "Busy": 0,
      "StatusLabel.text": "Aufgabe konnte nicht geladen werden. Bitte erneut laden.",
      "Naechste.visible": true
     },
     "scope": "stage"
    },
    {
     "id": "kr_act-5d33bb67-7b1d-4136-a97c-4b34765d6f20",
     "name": "Act_Karte_Objekt",
     "type": "variable",
     "source": "KartenAntwort",
     "sourceProperty": "card",
     "variableName": "AktuelleKarte",
     "scope": "stage"
    },
    {
     "id": "kr_act-3d443e3c-9f6f-4049-aabb-2d02eafefdf2",
     "name": "Act_Nr_Plus",
     "type": "calculate",
     "formula": "AufgabenNr + 1",
     "resultVariable": "AufgabenNr",
     "scope": "stage"
    },
    {
     "id": "kr_act-93ca6b04-2895-4c4f-8e2a-3e0101941ca2",
     "name": "Act_Karte_Uebernehmen",
     "type": "property",
     "changes": {
      "FrageLabel.text": "${KartenAntwort.card.question}",
      "FachLabel.text": "${KartenAntwort.card.subject} · ${KartenAntwort.card.topic} · Fach ${KartenAntwort.card.box}",
      "FortschrittLabel.text": "Aufgabe ${AufgabenNr} von ${Aufgaben}"
     },
     "scope": "stage"
    },
    {
     "id": "kr_act-e1f6f0be-a0eb-4daf-af93-98c584635493",
     "name": "Act_Ergebnis",
     "type": "calculate",
     "formula": "parseInt(AktuelleKarte.answers[0])",
     "resultVariable": "Ergebnis",
     "scope": "stage"
    },
    {
     "id": "kr_act-e4375457-6357-4b17-9ac8-b205d072199c",
     "name": "Act_Distraktor1",
     "type": "calculate",
     "formula": "Ergebnis + 1",
     "resultVariable": "Distrakt1",
     "scope": "stage"
    },
    {
     "id": "kr_act-6d1174e6-486f-4d30-b39d-06788ae1aecc",
     "name": "Act_Distraktor2",
     "type": "calculate",
     "formula": "Ergebnis > 1 ? Ergebnis - 1 : Ergebnis + 2",
     "resultVariable": "Distrakt2",
     "scope": "stage"
    },
    {
     "id": "kr_act-e4ee12b2-d966-4212-aa19-f1db8b1fb3f6",
     "name": "Act_Position",
     "type": "calculate",
     "formula": "Math.floor(Math.random() * 3) + 1",
     "resultVariable": "Pos",
     "scope": "stage"
    },
    {
     "id": "kr_act-e0b396e9-8e40-449f-b753-741f17ffad52",
     "name": "Act_VarianteA",
     "type": "property",
     "changes": {
      "BtnAntwortA.text": "${Ergebnis}",
      "BtnAntwortA.matchValue": "${Ergebnis}",
      "BtnAntwortB.text": "${Distrakt1}",
      "BtnAntwortB.matchValue": "${Distrakt1}",
      "BtnAntwortC.text": "${Distrakt2}",
      "BtnAntwortC.matchValue": "${Distrakt2}"
     },
     "scope": "stage"
    },
    {
     "id": "kr_act-b3f67c04-3e21-40a6-bf40-c6e3729fec79",
     "name": "Act_VarianteB",
     "type": "property",
     "changes": {
      "BtnAntwortA.text": "${Distrakt1}",
      "BtnAntwortA.matchValue": "${Distrakt1}",
      "BtnAntwortB.text": "${Ergebnis}",
      "BtnAntwortB.matchValue": "${Ergebnis}",
      "BtnAntwortC.text": "${Distrakt2}",
      "BtnAntwortC.matchValue": "${Distrakt2}"
     },
     "scope": "stage"
    },
    {
     "id": "kr_act-053a8cfd-458a-49d7-849a-88c4e3a4f4c1",
     "name": "Act_VarianteC",
     "type": "property",
     "changes": {
      "BtnAntwortA.text": "${Distrakt1}",
      "BtnAntwortA.matchValue": "${Distrakt1}",
      "BtnAntwortB.text": "${Distrakt2}",
      "BtnAntwortB.matchValue": "${Distrakt2}",
      "BtnAntwortC.text": "${Ergebnis}",
      "BtnAntwortC.matchValue": "${Ergebnis}"
     },
     "scope": "stage"
    },
    {
     "id": "kr_act-b0dc36d9-71dc-479e-b741-3acb4d7fdf8b",
     "name": "Act_Buttons_Bereit",
     "type": "property",
     "changes": {
      "Busy": 0,
      "StatusLabel.text": "",
      "BtnAntwortA.visible": true,
      "BtnAntwortB.visible": true,
      "BtnAntwortC.visible": true
     },
     "scope": "stage"
    },
    {
     "id": "kr_act-97b71d80-f153-4019-9848-1a68abfa8ee0",
     "name": "Act_BewertenR_Start",
